# NutriLens Environment Configuration
APP_NAME=NutriLens
ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (SQLite for local dev, Postgres compatible)
DATABASE_URL=sqlite:///./nutrilens.db

# Storage
STORAGE_DIR=uploads

# Vision AI Configuration
# Options: mock, gemini, claude, openai
VISION_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default User ID for single-user testing mode
DEFAULT_USER_ID=1
